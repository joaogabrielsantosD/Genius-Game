-- Authors: João Donato, Matheus Sousa.

TITLE "Top file";

INCLUDE "src/Debounce/debounce.inc";
INCLUDE "src/Buzzer/beep.inc";
INCLUDE "src/PRNG/PRNG.inc";
INCLUDE "src/FSM/FSM.inc";
INCLUDE "src/SevenSeg/sevenseg.inc";

CONSTANT MAX 			= 20;
DEFINE GAME_LIMIT(a) = ((a < MAX) ? a : MAX);  -- Limita a quantidade de rodadas ao máximo do projeto

CONSTANT MAX_ROUNDS = GAME_LIMIT(20); 		   -- Total de elementos da sequência
CONSTANT GAME_SIZE = CEIL(LOG2(MAX_ROUNDS)); -- Size in bits of the max rounds 

SUBDESIGN top
(
	clock : INPUT;
	rst_n : INPUT;
	
	key[3..0] : INPUT;
	
	led[3..0] : OUTPUT;
	buzzer : OUTPUT;
	seg[7..0] : OUTPUT;
	dig[3..0] : OUTPUT;
)

VARIABLE
	game_fsm : FSM WITH (SIZE = GAME_SIZE, MAX_ROUNDS = MAX_ROUNDS);
	rng : PRNG;
	b : beep;
	display : sevenseg;
	key0, key1, key2, key3 : debounce;
	
BEGIN
	DEFAULTS
		led[]  = 0;
		buzzer = GND;
		seg[]  = B"11111111";
		dig[]  = B"1111";
	END DEFAULTS;
	
	ASSERT (!MAX_ROUNDS)
	REPORT "o jogo nao pode ser igual a zero"
	SEVERITY error;
	
	-- Random Generator Inputs --
	rng.clock = clock;
	rng.reset = rst_n;
	rng.enable = VCC;
	
	-- Debounce Inputs --
	key0.clock  = clock; key0.key_in = key[0];
	key1.clock  = clock; key1.key_in = key[1];
	key2.clock  = clock; key2.key_in = key[2];
	key3.clock  = clock; key3.key_in = key[3];
	
	-- FSM Inputs --
	game_fsm.clock = clock;
	game_fsm.reset = rst_n;
	game_fsm.random_color[] = rng.rand[]; % PRNG OUTPUT %
	game_fsm.key0 = key0.f_key_out; %  Debounce OUTPUT % game_fsm.key0_raw = key[0];
	game_fsm.key1 = key1.f_key_out; %  Debounce OUTPUT %
	game_fsm.key2 = key2.f_key_out; %  Debounce OUTPUT %
	game_fsm.key3 = key3.f_key_out; %  Debounce OUTPUT % game_fsm.key3_raw = key[3];

	-- 7seg inputs
	display.clock = clock;
	display.value[] = game_fsm.display_value[];
	
	-- Buzzer inputs --
	b.clock = clock;
	b.data_in[] = game_fsm.led_out[];
	b.loser_flag = game_fsm.loser;
	
	-- 7seg outputs --
	seg[] = display.seg[];
	dig[] = display.dig[];

	-- FSM Outputs -- 
	led[] = NOT game_fsm.led_out[];
	buzzer = b.beep_out;
END;

