TITLE "sete_seg";

SUBDESIGN sete_seg 
(
	--clk, entrada[5..0], reset: INPUT;
	entrada[5..0] : INPUT;
	dig[3..0], seg[7..0]     : OUTPUT;
)

BEGIN
	dig[3..0] = B"1111";

	TABLE
		entrada[] => seg[];
		B"000000" => B"11111100"; -- 0
		B"000001" => B"01100000"; -- 1
		B"000010" => B"11011010"; -- 2
		B"000011" => B"11110010"; -- 3
		B"000100" => B"01100110"; -- 4
		B"000101" => B"10110110"; -- 5
		B"000110" => B"10111110"; -- 6
		B"000111" => B"11100000"; -- 7
		B"001000" => B"11111110"; -- 8
		B"001001" => B"11110110"; -- 9
		B"XX1X1X" => B"00000000"; -- >10
	END TABLE;
END;