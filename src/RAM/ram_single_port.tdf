TITLE "RAM memory";

SUBDESIGN ram_single_port 
(
	ram_clk, ram_wren	 : INPUT;
	ram_addr[5..0]	    : INPUT;
	ram_data_in[1..0]	 : INPUT;
	ram_data_out[1..0] : OUTPUT;
)
VARIABLE
	regs[20..0][1..0] : DFF;
BEGIN
	regs[][].clk = ram_clk;
	
	CASE ram_addr[] IS
		WHEN 0 =>
			IF ram_wren THEN
				regs[1][].d = regs[1][].q;
				regs[0][].d = ram_data_in[];
			ELSE
				regs[][].d = regs[][].q;
			END IF;
			ram_data_out[] = regs[0][].q;
		WHEN 1 =>
			IF ram_wren THEN
				regs[0][].d = regs[0][].q;
				regs[1][].d = ram_data_in[];
			ELSE
				regs[][].d = regs[][].q;
			END IF;
			ram_data_out[] = regs[1][].q;
		WHEN 2 =>
			IF ram_wren THEN
				regs[0][].d = regs[0][].q;
				regs[1][].d = regs[1][].q;
				regs[2][].d = ram_data_in[];
			ELSE
				regs[][].d = regs[][].q;
			END IF;
			ram_data_out[] = regs[2][].q;
