title "RAM memory";

subdesign ram_single_port 
(
	ram_clk, ram_wren	 : INPUT;
	ram_addr[5..0]	    : input;
	ram_data_in[1..0]	 : input;
	ram_data_out[1..0] : output;
)
variable
	regs[20..0][1..0] : DFF;
begin
	regs[][].clk = ram_clk;
	
	case ram_addr[] is
		when 0 =>
			if ram_wren then
				regs[1][].d = regs[1][].q;
				regs[0][].d = ram_data_in[];
			else
				regs[][].d = regs[][].q;
			end if;
			ram_data_out[] = regs[0][].q;
		when 1 =>
			if ram_wren then
				regs[0][].d = regs[0][].q;
				regs[1][].d = ram_data_in[];
			else
				regs[][].d = regs[][].q;
			end if;
			ram_data_out[] = regs[1][].q;
