			ELSE
				regs[][].d = regs[][].q;
			END IF;
			ram_data_out[] = regs[4][].q;
		WHEN 5 =>
			IF ram_wren THEN
				regs[0][].d = regs[0][].q;
				regs[1][].d = regs[1][].q;
				regs[2][].d = regs[2][].q;
