				regs[1][].d = regs[1][].q;
				regs[2][].d = regs[2][].q;
				regs[3][].d = regs[3][].q;
				regs[4][].d = regs[4][].q;
				regs[5][].d = regs[5][].q;
				regs[6][].d = regs[6][].q;
				regs[7][].d = regs[7][].q;
