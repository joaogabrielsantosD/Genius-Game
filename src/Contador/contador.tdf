TITLE "Contador circular crescente de i a j";

CONSTANT min_cnt = 0;
CONSTANT max_cnt = 21;
CONSTANT n       = CEIL(LOG2(max_cnt));

SUBDESIGN contador
(
	clk, load, ena, clr : INPUT;
	d[n-1..0] : INPUT;
	q[n-1..0] : OUTPUT;
	tc        : OUTPUT;
)

VARIABLE
	cnt[n-1..0] : DFF;
	aux         : NODE;
	
BEGIN
	cnt[].clk = clk;
	
	IF load == VCC THEN
		cnt[].d = d[];
	ELSIF clr == VCC THEN 
		cnt[].d = min_cnt;
	ELSIF (cnt[].q < max_cnt) & ena THEN
		aux = GND;
		cnt[].d = cnt[].q + 1;
	ELSIF (cnt[].q >= max_cnt) & ena THEN
		aux = VCC;
		cnt[].d = min_cnt;
	ELSE
		cnt[].d = cnt[].q;
	END IF;
	
	tc  = aux;
	q[] = cnt[]; 
END;