TITLE "FSM";

INCLUDE "src/RAM/ram_single_port.inc";
INCLUDE "src/Contador/contador.inc";

CONSTANT DELAY_500MS = 50000000;
CONSTANT DELAY_250MS = DELAY_500MS DIV 2;
CONSTANT DELAY_5S    = DELAY_500MS * 10;

PARAMETERS (ROUNDS = 5);
CONSTANT MAX_ROUNDS = ROUNDS - 1;

SUBDESIGN FSM
(
   clock, reset       : INPUT;

   key0_raw           : INPUT;
   key3_raw           : INPUT;

   key0               : INPUT;
   key1               : INPUT;
   key2               : INPUT;
   key3               : INPUT;

   random_color[1..0] : INPUT;

   led_out[3..0]      : OUTPUT;
   loser              : OUTPUT;
   get_color          : OUTPUT;
)

VARIABLE
   fsm_states : MACHINE WITH STATES (
      IDLE,
      START_GAME,
      SHOW_SEQUENCE,
      WAIT_RAM,
      UPDATE_SHOW_PTR,
      READ_COLOR,
      WAIT_RAM_READ,
      UPDATE_READ_PTR,
      NEW_ROUND,
      PLAYER_WIN,
      PLAYER_LOSE
   );

   ram : ram_single_port;
	
	game_round : contador;
	write_ptr  : contador;
	read_ptr   : contador;
	show_ptr   : contador;
   
	delay[31..0]       : DFF;
	
BEGIN
   DEFAULTS
      led_out[]  = 0;
      loser      = GND;
      get_color  = GND;
   END DEFAULTS;
	
   fsm_states.clk   = clock;
   fsm_states.reset = !reset;

   delay[].clk  = clock;  
	delay[].clrn = reset;

   ram.ram_clk = clock;
	
	game_round.clk = clock; game_round.clr = gnd;
	write_ptr.clk = clock;  write_ptr.clr  = gnd;
	read_ptr.clk = clock;
	show_ptr.clk = clock;
	
   -- --------------------------------------------------------
   -- FSM
   -- --------------------------------------------------------
   CASE fsm_states IS

      -- ------------------------------------------------------
      -- IDLE: pisca idle_counter nos LEDs enquanto espera
      --       KEY0+KEY3 simultâneos para iniciar o jogo.
      --       game_round é zerado aqui para garantir estado
      --       limpo ao entrar em START_GAME.
      -- ------------------------------------------------------
      WHEN IDLE =>
			get_color    = GND;
			led_out[]    = 0;
         write_ptr.load  = vcc; write_ptr.d[]  = 0;
         read_ptr.load   = vcc; read_ptr.d[]   = 0;
         show_ptr.load   = vcc; show_ptr.d[]   = 0;
         game_round.load = vcc; game_round.d[] = 0;

         IF (NOT key0_raw AND NOT key3_raw) THEN
            fsm_states = START_GAME;
         END IF;

      -- ------------------------------------------------------
      -- START_GAME: aguarda 500 ms (pausa visual), captura
      --             uma cor aleatória e grava na RAM na
      --             posição write_ptr atual.
      --             Ao fim, reseta show_ptr e vai exibir.
      -- ------------------------------------------------------
      WHEN START_GAME =>
         ram.ram_addr[] = write_ptr.q[];
			get_color      = VCC;

         IF delay[] < DELAY_500MS THEN
				ram.ram_wren = GND;
            delay[].d    = delay[] + 1;
            led_out[]    = 0;
         ELSE
            delay[].d         = 0;
				ram.ram_wren      = VCC;
            ram.ram_data_in[] = random_color[];
            show_ptr.clr = vcc;
            fsm_states        = SHOW_SEQUENCE;
         END IF;

      -- ------------------------------------------------------
      -- SHOW_SEQUENCE: coloca show_ptr no endereço da RAM e
      --                vai para WAIT_RAM aguardar 1 ciclo de
      --                latência antes de ler ram_data_out.
      -- ------------------------------------------------------
      WHEN SHOW_SEQUENCE =>
         ram.ram_addr[] = show_ptr.q[];
         ram.ram_wren   = GND;
         delay[].d      = 0;
         fsm_states     = WAIT_RAM;

      -- ------------------------------------------------------
      -- WAIT_RAM: ram_data_out já é válido aqui.
      --           Exibe o LED correspondente durante 250 ms.
      --           Ao fim do tempo decide: avançar ou ler input.
      -- ------------------------------------------------------
      WHEN WAIT_RAM =>
         ram.ram_addr[] = show_ptr.q[];
         ram.ram_wren   = GND;

         IF delay[] < DELAY_250MS THEN
            delay[].d = delay[] + 1;
            IF    ram.ram_data_out[] == B"00" THEN led_out[] = B"0001";
            ELSIF ram.ram_data_out[] == B"01" THEN led_out[] = B"0010";
            ELSIF ram.ram_data_out[] == B"10" THEN led_out[] = B"0100";
            ELSIF ram.ram_data_out[] == B"11" THEN led_out[] = B"1000";
            END IF;
            fsm_states = WAIT_RAM;
         ELSE
            -- show_ptr percorre 0..game_round[] inclusive
            IF show_ptr.q[] == game_round.q[] THEN
               read_ptr.clr = vcc;
               delay[].d  = 0;
               fsm_states = READ_COLOR;
            ELSE
               delay[].d  = 0;
               fsm_states = UPDATE_SHOW_PTR;
            END IF;
         END IF;

      -- ------------------------------------------------------
      -- UPDATE_SHOW_PTR: avança show_ptr e volta para
      --                  SHOW_SEQUENCE (que vai para WAIT_RAM).
      -- ------------------------------------------------------
      WHEN UPDATE_SHOW_PTR =>
         show_ptr.ena = vcc;
         delay[].d  = 0;
         fsm_states = SHOW_SEQUENCE;

      -- ------------------------------------------------------
      -- READ_COLOR: coloca read_ptr no endereço e vai para
      --             WAIT_RAM_READ aguardar 1 ciclo de latência.
      -- ------------------------------------------------------
      WHEN READ_COLOR =>
         ram.ram_addr[] = read_ptr.q[];
         ram.ram_wren   = GND;
         fsm_states     = WAIT_RAM_READ;

      -- ------------------------------------------------------
      -- WAIT_RAM_READ: ram_data_out já é válido aqui.
      --                Aguarda input do jogador ou timeout.
      -- ------------------------------------------------------
      WHEN WAIT_RAM_READ =>
         ram.ram_addr[] = read_ptr.q[];
         ram.ram_wren   = GND;

         IF (key0 OR key1 OR key2 OR key3) THEN
            -- Tecla pressionada: verifica se é a correta
            IF (key0 AND (ram.ram_data_out[1..0] == B"00")) OR
               (key1 AND (ram.ram_data_out[1..0] == B"01")) OR
               (key2 AND (ram.ram_data_out[1..0] == B"10")) OR
               (key3 AND (ram.ram_data_out[1..0] == B"11")) THEN
					
               delay[].d = 0;
               -- read_ptr percorre 0..game_round[] inclusive
               IF read_ptr.q[] == game_round.q[] THEN
                  IF game_round.q[] == MAX_ROUNDS THEN
                     fsm_states = PLAYER_WIN;
                  ELSE
                     fsm_states = NEW_ROUND;
                  END IF;
               ELSE
                  fsm_states = UPDATE_READ_PTR;
               END IF;
            ELSE
               -- Tecla errada → derrota imediata
               delay[].d  = 0;
               fsm_states = PLAYER_LOSE;
            END IF;

         ELSIF delay[] < DELAY_5S THEN
            delay[].d = delay[] + 1;
         ELSE
            -- Timeout → derrota
            delay[].d  = 0;
            fsm_states = PLAYER_LOSE;
         END IF;

      -- ------------------------------------------------------
      -- UPDATE_READ_PTR: avança read_ptr e volta para
      --                  READ_COLOR (que vai para WAIT_RAM_READ).
      -- ------------------------------------------------------
      WHEN UPDATE_READ_PTR =>
         delay[].d  = 0;
         read_ptr.ena = vcc;
         fsm_states = READ_COLOR;

      -- ------------------------------------------------------
      -- NEW_ROUND: pausa de 250 ms entre rodadas, depois
      --            avança write_ptr e game_round e volta para
      --            START_GAME para gravar a nova cor.
      -- ------------------------------------------------------
      WHEN NEW_ROUND =>
         IF delay[] < DELAY_250MS THEN
            delay[].d = delay[] + 1;
         ELSE
				game_round.ena = vcc;
            write_ptr.ena = vcc;
				delay[].d    = 0;
            read_ptr.clr = vcc;
            show_ptr.clr = vcc;	
            fsm_states   = START_GAME;
         END IF;

      -- ------------------------------------------------------
      -- PLAYER_WIN: todos os LEDs acesos, loop eterno.
      --             TODO: exibir recorde no 7seg
      -- ------------------------------------------------------
      WHEN PLAYER_WIN =>
         loser      = GND;
         led_out[]  = B"1111";
         fsm_states = PLAYER_WIN;

      -- ------------------------------------------------------
      -- PLAYER_LOSE: LEDs 1 e 2 acesos, sinal loser ativo.
      --              TODO: limpar 7seg
      -- ------------------------------------------------------
      WHEN PLAYER_LOSE =>
         loser      = VCC;
         led_out[]  = B"0110";
         fsm_states = PLAYER_LOSE;

      WHEN OTHERS =>
         fsm_states = IDLE;

   END CASE;
END;