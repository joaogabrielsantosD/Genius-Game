-- TODO: Implement 7seg and add in the states
-- TODO: Add led output according the color
-- TODO: Add tunes buzzer according the color
-- TODO: Implement the random algorithm

TITLE "FSM";

INCLUDE "src/PRNG/PRNG.inc";

CONSTANT DELAY_500MS = 50000000; 			   -- Delay for 50MHz Clock, after 50000000 pulses
CONSTANT DELAY_250MS = DELAY_500MS DIV 2; 	-- Delay for 50MHz Clock, after 25000000 pulses
CONSTANT DELAY_5S = DELAY_500MS * 10; 			-- Delay for 50MHz Clock, after 5s

PARAMETERS (SIZE = 5, MAX_ROUNDS = 20);
SUBDESIGN FSM
(
	clock, reset : INPUT;  -- Clock and reset signal

	key0_raw : INPUT;
	key3_raw : INPUT;
	
	key0 : INPUT;  -- Keys/Buttons inputs
	key1 : INPUT;  -- Keys/Buttons inputs
	key2 : INPUT;  -- Keys/Buttons inputs
	key3 : INPUT;  -- Keys/Buttons inputs
	
	led_out[3..0] : OUTPUT;
	b : OUTPUT; -- Buzzer output
)

VARIABLE
	fsm_states   : MACHINE WITH STATES(IDLE, START_GAME, SET_COLOR, WAIT, READ_COLOR, PLAYER_WIN, PLAYER_LOSE); -- FSM states
	delay[31..0] : DFF; -- Game target delay (4 bytes)
	
	game_round[SIZE-1..0] : DFF; -- Save the current round
	temp[SIZE-1..0] 		: DFF; -- counter to current round
	
	key0_flag : DFF;
	key3_flag : DFF;

	rng : PRNG;
	rng_enable : NODE;

	color_id[1..0] : DFF;
	color_led[3..0] : NODE;
	
BEGIN
	%DEFAULTS
		-- fsm_states = IDLE; -- Set FSM how IDLE
		b = GND;
		led_out[] = 0;
		
		delay[].d = 0;
		game_round[].d = 1; -- Start round 1
		temp[].d = 1;		  -- Start round 1
		
		key0_flag.d = GND;
		key3_flag.d = GND;
		rng_enable = GND;
		color_id[].d = color_id[];

	END DEFAULTS;%
	fsm_states.clk = clock; -- Syncronize clock
	fsm_states.reset = !reset; -- Reset FSM
	
	delay[].clk = clock;  -- Syncronize clock
	delay[].clrn = reset; -- Reset FSM
	
	game_round[].clk = clock;  -- Syncronize clock
	game_round[].clrn = reset; -- Reset FSM

	temp[].clk = clock;  -- Syncronize clock
	temp[].clrn = reset; -- Reset FSM
	
	key0_flag.clk = clock; key0_flag.clrn = reset;
	key3_flag.clk = clock; key3_flag.clrn = reset;
	color_id[].clk = clock; color_id[].clrn = reset;

	rng.clock = clock;
	rng.reset = reset;
	rng.enable = rng_enable;
	
	IF key0 THEN
		key0_flag.d = VCC;
	END IF;
		
	IF key3 THEN
		key3_flag.d = VCC;
	END IF;

	color_led[] = B"0001";
	IF color_id[] == B"01" THEN
		color_led[] = B"0010";
	ELSIF color_id[] == B"10" THEN
		color_led[] = B"0100";
	ELSIF color_id[] == B"11" THEN
		color_led[] = B"1000";
	ELSE
		-- fsm_states = IDLE; -- Set FSM how IDLE
		b = GND;
		led_out[] = 0;
		
		delay[].d = 0;
		game_round[].d = 1; -- Start round 1
		temp[].d = 1;		  -- Start round 1
		
		key0_flag.d = GND;
		key3_flag.d = GND;
		rng_enable = GND;
		color_id[].d = color_id[].q;
	END IF;
	
	CASE fsm_states IS
		
		WHEN IDLE =>
			-- TODO: Show record value (7seg.inc)
			led_out[] = 0;
			-- TODO: Clear output tone buzzer
			
			game_round[].d = 1;  -- reset game
			temp[].d = 1;  		-- reset round counter
			delay[].d = 0; 		-- reset delay counter
			
			-- Sequence to start the game (key[0] + key[3])
			IF (key0_flag.q AND key3_flag.q) OR (NOT key0_raw AND NOT key3_raw) THEN
				key0_flag.d = GND;
				key3_flag.d = GND;
				fsm_states = START_GAME;
			ELSE
				fsm_states = IDLE;
			END IF;
		
		WHEN START_GAME =>
			-- TODO: Clear 7seg here (7seg.inc)
			led_out[] = 0;
			-- TODO: Clear output tone buzzer

			IF	delay[] < DELAY_500MS THEN -- Wait 0.5s to set the color
				delay[].d = delay[] + 1;
			ELSE
				delay[].d = 0;
				rng_enable = VCC;
				color_id[].d = rng.rand[];
				fsm_states = SET_COLOR;
			END IF;
			
		WHEN SET_COLOR =>
			-- Random color selected in START_GAME
			led_out[] = color_led[];
			-- TODO: Show the number in 7seg according the color
			-- TODO: Output tone buzzer according the color
			fsm_states = WAIT;
			
		WHEN WAIT =>
			IF delay[] < DELAY_250MS THEN -- wait 0.25s to the next color
				delay[].d = delay[] + 1;
				led_out[] = color_led[];
				fsm_states = WAIT;
			ELSE
				delay[].d = 0;
				
				IF (temp[] == game_round[]) THEN
					fsm_states = READ_COLOR;
				ELSE
					temp[].d = temp[] + 1; -- increment temp
					fsm_states = START_GAME;
				END IF;
			END IF;
			
		WHEN READ_COLOR =>
			-- TODO: Get button input
			-- TODO: Check if the Colors IDs match with the game
			-- TODO: IF wrong, jump state, ELSE do the TODOs
			-- TODO (1): Set led output according the color
			-- TODO (2): Show the number in 7seg according the color
			-- TODO (3): Output tone buzzer according the color
			
			IF delay[] < DELAY_5S THEN
				delay[].d = delay[] + 1;
				
				IF key0 THEN led_out[] = B"0001"; fsm_states = PLAYER_WIN; delay[].d = 0;
				ELSIF key1 THEN led_out[] = B"0010";
				ELSIF key2 THEN led_out[] = B"0100";
				ELSIF key3 THEN led_out[] = B"1000";
				ELSE         led_out[] = 0;
				END IF;
				
				
				-- IF GND == VCC THEN 					-- TODO: cor_de_entrada == cor_da_sequencia
				-- 	-- TODO  (1 & 2 & 3)
				-- 	-- INVERSE OF TODO (1 & 2 & 3) 		-- create a pulse only
				-- 	IF VCC == VCC THEN				-- TODO: cor_de_entrada == cor_da_ultima_sequencia
				-- 		IF game_round[] == MAX_ROUNDS THEN
				-- 			fsm_states = PLAYER_WIN;
				-- 		ELSE
				-- 			temp[].d = 1;
				-- 			game_round[].d = game_round[] + 1; -- Increment gamee round
				-- 			fsm_states = START_GAME;
				-- 		END IF;
				-- 	END IF;
				-- 	
				-- 	delay[].d = 0;
				-- ELSE
				-- 	delay[].d = 0;
				-- 	fsm_states = PLAYER_LOSE;
				-- END IF;
			ELSE
				delay[].d = 0;
				fsm_states = PLAYER_LOSE;
			END IF;
			
		WHEN PLAYER_WIN =>
			-- TODO: Show record 7seg (7seg.inc)
			led_out[] = B"1111";
			-- TODO: Winner output tone buzzer
			
			fsm_states = PLAYER_WIN;
			
		WHEN PLAYER_LOSE =>
			-- TODO: CLear 7seg (7seg.inc)
			led_out[] = 0;
			-- TODO: Loser output tone buzzer
			
			b = VCC;
			fsm_states = PLAYER_LOSE;
			
		WHEN OTHERS =>
			fsm_states = IDLE; -- back to the IDLE state
	END CASE;
END;