TITLE "PRNG";	

-- Number of bits used by the generators
CONSTANT m = 8;

-- Initial seed values
CONSTANT SEED_X = B"10100101";
CONSTANT SEED_Y = B"01100110";

SUBDESIGN PRNG
(
	clock, reset : INPUT;
	enable       : INPUT;
	
	rand[1..0]   : OUTPUT;
)

VARIABLE
	xn[m-1..0] : DFF;	-- First pseudo-random register
	yn[m-1..0] : DFF;	-- Second pseudo-random register
	seeded     : DFF;	-- Indicates whether initial seeds were loaded

	x_next[m-1..0] : NODE; 	-- Next value for xn
	y_next[m-1..0] : NODE; 	-- Next value for yn

BEGIN
	--DEFAULTS
	--	xn[].d = xn[].q;
	--	yn[].d = yn[].q;
	--   seeded.d = seeded.q;
	--END DEFAULTS;
	
	xn[].clk = clock;    xn[].clrn = reset;
	yn[].clk = clock;    yn[].clrn = reset;
	seeded.clk = clock;  seeded.clrn = reset;

	x_next[] = (xn[m-2..0].q, GND) + yn[].q;
	y_next[] = yn[].q + xn[].q;

	IF seeded.q == GND THEN
		xn[].d = SEED_X;
		yn[].d = SEED_Y;
		seeded.d = VCC;
	ELSIF enable THEN
		xn[].d = x_next[];
		yn[].d = y_next[];
		seeded.d = seeded.q;
   ELSE
		xn[].d = xn[].q;
		yn[].d = yn[].q;
		seeded.d = seeded.q;
	END IF;

	rand[] = xn[1..0].q XOR yn[7..6].q;
	--rand[] = xn[m-2 .. m-3].q XOR yn[m-2 .. m-3].q;
END;

